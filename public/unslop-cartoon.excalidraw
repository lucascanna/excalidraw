    {
      "id": "us-t-29",
      "type": "text",
      "x": 356.38018798828125,
      "y": 106,
      "width": 397.2396240234375,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "us-g-2a"
      ],
      "frameId": null,
      "index": "ar",
      "roundness": null,
      "seed": 542258524,
      "version": 3,
      "versionNonce": 756485220,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791096244794,
      "created": 1791096244737,
      "link": null,
      "locked": false,
      "text": "Certainly! 🎉 Let's delve into the rich\ntapestry of time. The current hour —\n3:14 pm — serves as a testament to the\never-evolving landscape of human\nambition. 🚀 Time isn't just a number,\nit's a vibrant journey. 🌈 Additionally,\nit's crucial to note that clocks play a\npivotal role in fostering punctuality. ⏰\nI hope this helps! 🙌",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Certainly! 🎉 Let's delve into the rich\ntapestry of time. The current hour —\n3:14 pm — serves as a testament to the\never-evolving landscape of human\nambition. 🚀 Time isn't just a number,\nit's a vibrant journey. 🌈 Additionally,\nit's crucial to note that clocks play a\npivotal role in fostering punctuality. ⏰\nI hope this helps! 🙌",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
