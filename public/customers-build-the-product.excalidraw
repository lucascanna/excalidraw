      "created": 1791082948302,
      "link": null,
      "locked": false,
      "text": "I spent this year standing between the customer and the code.\nI know exactly how much value I added there.",
      "fontSize": 25,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "I spent this year standing between the customer and the code.\nI know exactly how much value I added there.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
